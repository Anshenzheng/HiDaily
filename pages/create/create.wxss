.container {
  padding: 24rpx;
  padding-bottom: 40rpx;
}

.form-section {
  margin-bottom: 24rpx;
}

.form-item {
  width: 100%;
}

.form-label {
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 20rpx;
}

.text-small {
  font-size: 24rpx;
}

.text-secondary {
  color: #666666;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  color: #333333;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  height: 200rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #333333;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

.icon-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.icon-item {
  width: 22%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  background-color: #f8f9fa;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.icon-item.selected {
  background-color: #E8F5E9;
  border-color: #4CAF50;
}

.icon-emoji {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.icon-label {
  font-size: 22rpx;
  color: #666666;
}

.frequency-type {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.frequency-item {
  flex: 1;
  padding: 24rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #666666;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.frequency-item.selected {
  color: #4CAF50;
  background-color: #E8F5E9;
  border-color: #4CAF50;
  font-weight: 500;
}

.frequency-value {
  margin-bottom: 16rpx;
}

.picker-value, .time-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  font-size: 32rpx;
  color: #333333;
}

.picker-arrow {
  font-size: 24rpx;
  color: #999999;
}

.frequency-desc {
  font-size: 26rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.reminder-time {
  margin-top: 20rpx;
}

.action-section {
  padding: 24rpx 0;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(76, 175, 80, 0.3);
}

.submit-btn::after {
  border: none;
}

.delete-section {
  margin-top: 32rpx;
  text-align: center;
}

.delete-btn {
  display: inline-block;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  color: #F44336;
  text-decoration: underline;
}

.flex {
  display: flex;
}

.justify-between {
  justify-content: space-between;
}

.align-center {
  align-items: center;
}
